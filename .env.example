# Application Profile
RUST_BACKTRACE=1
RUST_LOG=debug
SERVER_HOST=0.0.0.0
SERVER_PORT=3000          # Internal container port (Nginx upstream)
NGINX_PORT=80

# Environment (production, staging, development)
# Production: Requires CF-Connecting-IP header (strict security)
# Development: Permits X-Forwarded-For fallback (local testing)
ENVIRONMENT=development

# Force Cloudflare header validation even in non-production
# Set to true for staging environments behind Cloudflare
REQUIRE_CLOUDFLARE_HEADERS=false

# OAuth Redirect URL (must match Google Cloud Console)
# Development: http://localhost:3000
# Production: https://yourdomain.com
OAUTH_REDIRECT_BASE_URL=http://localhost:3000

# Security & CORS
CORS_ALLOWED_ORIGINS=""
JWT_SECRET=replace_this_with_a_secure_secret_in_production

# Token TTLs
ACCESS_TOKEN_TTL_SECS=900          # 15 minutes
REFRESH_TOKEN_TTL_DAYS=14
AUTH_REQUIRE_USERNAME_ON_GOOGLE_SIGNUP=true
TERMS_CURRENT_VERSION=v1
TERMS_URL=
# Backend-hosted terms content (choose one source; not both):
TERMS_CONTENT=
TERMS_CONTENT_FILE_PATH=docs/legal/terms/memegy_terms_v1.md
TERMS_CONTENT_TYPE=text/markdown
TERMS_REQUIRE_VERSION_MATCH=true
TERMS_LEGAL_CONTACT_EMAIL=legal@example.com
TERMS_ABUSE_CONTACT_EMAIL=abuse@example.com
TERMS_JURISDICTIONS=US,TR,GLOBAL
READ_ONLY_MODE_ENABLED=false
MAINTENANCE_MODE_ENABLED=false
USERNAME_RESERVED_VALUES="admin,support,api,root,system,me,users,auth,feed,superuser,staff,moderator,manager,editor,superadmin,sysadmin,administrator,operator,dev,developer,qa,test,testing,contact,help,info,security,abuse,postmaster,webmaster,host"
ADMIN_API_ENABLED=false
ADMIN_JWT_ISSUER=
ADMIN_JWT_AUDIENCE=
ADMIN_JWT_PUBLIC_KEYS_JSON={}
ADMIN_JWT_MAX_TTL_SECS=300
ADMIN_JWT_CLOCK_SKEW_SECS=60
ADMIN_REPLAY_PROTECTION_ENABLED=true
ADMIN_ALLOWED_IP_CIDRS=

# Auth Provider (Google)
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
MOBILE_APP_SCHEME=yourapp://

# Database (Postgres)
POSTGRES_USER=app_user
POSTGRES_PASSWORD=secure_db_password
POSTGRES_DB=memegy_db
DATABASE_URL=postgres://app_user:secure_db_password@localhost:5432/memegy_db

# Cache (Valkey)
VALKEY_PASSWORD=secure_cache_password
VALKEY_URL=redis://:secure_cache_password@localhost:6379

# Object Storage (MinIO)Y
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=secure_minio_password
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET_VIDEOS=videos-public
MINIO_BUCKET_RAW=videos-raw
PRESIGNED_URL_EXPIRY_SECS=3600    # 1 hour

# File Upload Limits
MAX_FILE_SIZE_BYTES=33554432       # 32 MB per file
LIMIT_UPLOAD_BYTES_HOURLY=268435456  # 256 MB per hour
UPLOAD_SIZE_TOLERANCE_BYTES=0      # Required size match tolerance for confirm step
MIN_VIDEO_SIZE_BYTES=1024          # Reject tiny/broken uploads

# Feed Configuration
FEED_PAGE_SIZE=20
FEED_CACHE_TTL_SECS=300            # 5 minutes
LIMIT_FEED_RPM=60                  # 60 requests per minute

# Rate Limiting
RATE_LIMIT_WINDOW_SECS=3600        # 1 hour
IP_RATE_LIMIT_RPM=30               # 30 requests per minute per IP
LIKE_ACTIONS_RPM_LIMIT=60          # Like/unlike actions per user per window
LIKE_ACTIONS_WINDOW_SECS=60        # Like/unlike rate limit window (seconds)
USERNAME_SIGNUP_RPM_PER_IP=20      # Username setup requests per minute per IP
USERNAME_SIGNUP_ATTEMPTS_PER_TICKET=10
USERNAME_UPDATE_RPM_PER_USER=5     # Username changes per minute per user
READ_ONLY_STATUS_RPM_PER_USER=20
MAINTENANCE_STATUS_RPM_PER_USER=20
ONBOARDING_STATUS_RPM_PER_USER=30
ONBOARDING_COMPLETE_RPM_PER_USER=10
REPORT_CREATE_RPM_PER_USER=10
REPORT_CREATE_RPM_PER_IP=20
REPORT_DETAILS_MAX_CHARS=2000
REPORT_REASON_MAX_COUNT=5
AUTO_QUARANTINE_ENABLED=true
AUTO_QUARANTINE_WINDOW_SECS=1800
AUTO_QUARANTINE_SEVERE_DISTINCT_REPORTERS=2
ABUSE_REPORT_RETENTION_DAYS=365
ABUSE_REPORT_PURGE_INTERVAL_SECS=86400

# OTC Exchange Rate Limiting (Security)
OTC_RATE_LIMIT_MAX_ATTEMPTS=5      # Max OTC exchange attempts per IP
OTC_RATE_LIMIT_WINDOW_SECONDS=60   # Rate limit window (1 minute)

# Worker Configuration
DRAFT_VIDEO_CLEANUP_HOURS=2
WORKER_RETRY_MAX_ATTEMPTS=3
WORKER_RETRY_BACKOFF_BASE_SECS=2
FFMPEG_TRANSCODE_TIMEOUT_SECS=180
FFMPEG_THUMBNAIL_TIMEOUT_SECS=30

# Download Limits
DOWNLOAD_RPM_LIMIT=30                     # Downloads per minute per user
DOWNLOAD_BANDWIDTH_HOURLY_MB=500          # Bandwidth limit in MB per hour
PRESIGNED_DOWNLOAD_URL_EXPIRY_SECS=60     # Download URL expiry (60 seconds)
DOWNLOAD_REFRESH_RPM_LIMIT=10             # URL refresh requests per minute

# Bulk Download Configuration  
MAX_BULK_DOWNLOAD_COUNT=10                # Max videos per bulk download
BULK_DOWNLOAD_ACTIVE_JOBS_LIMIT=3         # Max concurrent jobs per user
BULK_DOWNLOAD_DAILY_LIMIT=10              # Max bulk jobs per day per user
MINIO_BUCKET_DOWNLOADS=downloads          # S3 bucket for ZIP files
BULK_DOWNLOAD_ZIP_EXPIRY_DAYS=7           # ZIP file retention (7 days)

# Search Configuration (Security)
SEARCH_MAX_TOKENS=50                      # Max search terms (ReDoS protection)
SEARCH_MAX_TOKEN_LENGTH=50                # Max chars per term (ReDoS protection)
SEARCH_MAX_QUERY_CHARS=200                # Max total query length
SEARCH_TIMEOUT_SECS=5                     # Database query timeout
SEARCH_CACHE_TTL_SECS=10                  # Search result cache TTL
SEARCH_RPM_LIMIT=30                       # Searches per minute per user

# Keyboard Extension (MVP)
EXTENSION_TOKEN_TTL_SECS=600              # Extension token TTL (10 min)
KEYBOARD_SEARCH_RPM=60                    # Keyboard searches per minute
KEYBOARD_SEARCH_MAX_LIMIT=20              # Max keyboard search page size
KEYBOARD_SEND_TICKET_RPM=30               # Send-ticket requests per minute
KEYBOARD_DAILY_SEND_CAP=100               # Max send tickets per UTC day
KEYBOARD_NONCE_TTL_SECS=300               # Nonce replay guard TTL
KEYBOARD_TICKET_TTL_SECS=45               # Send-ticket validity window
KEYBOARD_MEDIA_URL_TTL_SECS=30            # Media presigned URL TTL

# Realtime WebSocket (Video status signals)
VIDEO_WS_ENABLED=true
VIDEO_WS_MAX_CONN_PER_USER=3
VIDEO_WS_MAX_CONN_GLOBAL=5000
VIDEO_WS_CONNECT_RPM_PER_IP=30
VIDEO_WS_CONNECT_RPM_PER_USER=60
VIDEO_WS_SEND_BUFFER=64
VIDEO_WS_HEARTBEAT_SECS=20
