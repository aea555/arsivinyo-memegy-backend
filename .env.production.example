# Application Profile
# Production Environment
RUST_BACKTRACE=0
RUST_LOG=info
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
NGINX_PORT=80

ENVIRONMENT=production

# Require Cloudflare Headers (Security)
# Ensure this is TRUE for production to prevent circumventing Cloudflare
REQUIRE_CLOUDFLARE_HEADERS=true

# Security & CORS
# Comma separated list of allowed origins.
# IMPORTANT: Add your production frontend domain here
CORS_ALLOWED_ORIGINS="https://memegy.com,https://api.memegy.com"
JWT_SECRET=CHANGE_THIS_TO_A_VERY_SECURE_RANDOM_STRING_FOR_PROD
OAUTH_REDIRECT_BASE_URL=https://memegy.com

# Token TTLs
ACCESS_TOKEN_TTL_SECS=900          # 15 minutes
REFRESH_TOKEN_TTL_DAYS=30          # 30 days for convenience
AUTH_REQUIRE_USERNAME_ON_GOOGLE_SIGNUP=true
USERNAME_RESERVED_VALUES="admin,support,api,root,system,me,users,auth,feed,superuser,staff,moderator,manager,editor,superadmin,sysadmin,administrator,operator,dev,developer,qa,test,testing,contact,help,info,security,abuse,postmaster,webmaster,host"
ADMIN_API_ENABLED=false
ADMIN_JWT_ISSUER=
ADMIN_JWT_AUDIENCE=
ADMIN_JWT_PUBLIC_KEYS_JSON={}
ADMIN_JWT_MAX_TTL_SECS=300
ADMIN_JWT_CLOCK_SKEW_SECS=60
ADMIN_REPLAY_PROTECTION_ENABLED=true
ADMIN_ALLOWED_IP_CIDRS=

# Database (Postgres)
POSTGRES_USER=memegy_prod_admin
POSTGRES_PASSWORD=CHANGE_THIS_PROD_DB_PASSWORD
POSTGRES_DB=memegy_prod_db
DATABASE_URL=postgres://memegy_prod_admin:CHANGE_THIS_PROD_DB_PASSWORD@db:5432/memegy_prod_db

# Durable host paths (outside git repo)
PROD_POSTGRES_DATA_DIR=/var/lib/memegy/postgres
PROD_VALKEY_DATA_DIR=/var/lib/memegy/valkey
PROD_MINIO_DATA_DIR=/var/lib/memegy/minio

# Cache (Valkey)
VALKEY_PASSWORD=CHANGE_THIS_PROD_REDIS_PASSWORD
VALKEY_URL=redis://:CHANGE_THIS_PROD_REDIS_PASSWORD@cache:6379

# Object Storage (MinIO)
MINIO_ROOT_USER=minio_prod_admin
MINIO_ROOT_PASSWORD=CHANGE_THIS_PROD_MINIO_PASSWORD
MINIO_ENDPOINT=http://minio:9000
# IMPORTANT: This must be the PUBLIC URL reachable by users (via Cloudflare Tunnel)
# e.g., https://media.memegy.com
MINIO_PUBLIC_ENDPOINT=https://media.memegy.com
MINIO_BUCKET_VIDEOS=videos-public
MINIO_BUCKET_RAW=videos-raw
PRESIGNED_URL_EXPIRY_SECS=3600    # 1 hour

# Rate Limiting (Stricter for Prod)
MAX_FILE_SIZE_BYTES=33554432       # 32 MB
LIMIT_UPLOAD_BYTES_HOURLY=268435456  # 256 MB
UPLOAD_SIZE_TOLERANCE_BYTES=0
MIN_VIDEO_SIZE_BYTES=1024

# Feed Configuration
FEED_PAGE_SIZE=20
FEED_CACHE_TTL_SECS=300
LIMIT_FEED_RPM=60

# Rate Limiting
RATE_LIMIT_WINDOW_SECS=3600
IP_RATE_LIMIT_RPM=30
LIKE_ACTIONS_RPM_LIMIT=60
LIKE_ACTIONS_WINDOW_SECS=60
USERNAME_SIGNUP_RPM_PER_IP=20
USERNAME_SIGNUP_ATTEMPTS_PER_TICKET=10
USERNAME_UPDATE_RPM_PER_USER=5

# OTC Exchange Rate Limiting (Security)
OTC_RATE_LIMIT_MAX_ATTEMPTS=3      # Stricter for production
OTC_RATE_LIMIT_WINDOW_SECONDS=120  # 2 minutes

# Worker Configuration
DRAFT_VIDEO_CLEANUP_HOURS=2
WORKER_RETRY_MAX_ATTEMPTS=5
WORKER_RETRY_BACKOFF_BASE_SECS=2
FFMPEG_TRANSCODE_TIMEOUT_SECS=180
FFMPEG_THUMBNAIL_TIMEOUT_SECS=30

GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
MOBILE_APP_SCHEME=yourapp://

# Download Limits
DOWNLOAD_RPM_LIMIT=30
DOWNLOAD_BANDWIDTH_HOURLY_MB=512
PRESIGNED_DOWNLOAD_URL_EXPIRY_SECS=60
DOWNLOAD_REFRESH_RPM_LIMIT=10

# Bulk Download Configuration
MAX_BULK_DOWNLOAD_COUNT=20
BULK_DOWNLOAD_ACTIVE_JOBS_LIMIT=3
BULK_DOWNLOAD_DAILY_LIMIT=20
MINIO_BUCKET_DOWNLOADS=downloads
BULK_DOWNLOAD_ZIP_EXPIRY_DAYS=7

# Keyboard Extension (MVP)
EXTENSION_TOKEN_TTL_SECS=600
KEYBOARD_SEARCH_RPM=60
KEYBOARD_SEARCH_MAX_LIMIT=20
KEYBOARD_SEND_TICKET_RPM=30
KEYBOARD_DAILY_SEND_CAP=100
KEYBOARD_NONCE_TTL_SECS=300
KEYBOARD_TICKET_TTL_SECS=45
KEYBOARD_MEDIA_URL_TTL_SECS=30

# Realtime WebSocket (Video status signals)
VIDEO_WS_ENABLED=true
VIDEO_WS_MAX_CONN_PER_USER=3
VIDEO_WS_MAX_CONN_GLOBAL=5000
VIDEO_WS_CONNECT_RPM_PER_IP=30
VIDEO_WS_CONNECT_RPM_PER_USER=60
VIDEO_WS_SEND_BUFFER=64
VIDEO_WS_HEARTBEAT_SECS=20

PROD_POSTGRES_DATA_DIR=/path/to/prod/postgres/data
PROD_VALKEY_DATA_DIR=/path/to/prod/valkey/data
PROD_MINIO_DATA_DIR=/path/to/prod/minio/data