# Self-hosted runner MinIO backup settings
# Source this file before running scripts/backup/minio_snapshot_backup.sh

# SSH tunnel source (VPS)
VPS_SSH_HOST=your-vps-host
VPS_SSH_USER=backup_user
VPS_SSH_PORT=22
VPS_SSH_KEY_FILE=$HOME/.ssh/memegy_backup_id_ed25519
VPS_SSH_STRICT_HOST_KEY_CHECKING=accept-new

# MinIO auth (through tunnel)
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
SSH_TUNNEL_LOCAL_BIND=127.0.0.1
SSH_TUNNEL_LOCAL_PORT=19000
SSH_TUNNEL_REMOTE_HOST=127.0.0.1
SSH_TUNNEL_REMOTE_PORT=9000
MINIO_ENDPOINT=http://127.0.0.1:19000

# Restic repository and encryption
# Example repository (Google Drive via rclone backend):
# RESTIC_REPOSITORY=rclone:gdrive:memegy-backups/minio-prod
RESTIC_REPOSITORY=rclone:gdrive:memegy-backups/minio-prod
RESTIC_PASSWORD=CHANGE_ME
RESTIC_COMPRESSION=auto
RESTIC_CHECK_READ_DATA_SUBSET=5%

# Optional: point restic/rclone at a specific rclone config file
# RCLONE_CONFIG=$HOME/.config/rclone/rclone.conf

# Local state and mirror cache (persistent)
BACKUP_STATE_DIR=$HOME/.local/state/memegy-backup
MINIO_MIRROR_DIR=$HOME/memegy-backups/minio-mirror
LOCK_FILE=$HOME/.local/state/memegy-backup/minio-backup.lock
LAST_SUCCESS_FILE=$HOME/.local/state/memegy-backup/minio-last-success-epoch.txt
MANIFEST_DIR=$HOME/.local/state/memegy-backup/manifests

# Cadence and retention
BACKUP_MIN_INTERVAL_SECS=259200
RETENTION_KEEP_WITHIN=90d

# rclone sync tuning
RCLONE_TRANSFERS=4
RCLONE_CHECKERS=8
RCLONE_BWLIMIT=off
RCLONE_RETRIES=3
RCLONE_LOW_LEVEL_RETRIES=6
RCLONE_STATS_ONE_LINE=true

# Host resource throttling (laptop)
NICE_LEVEL=10
IONICE_CLASS=2
IONICE_LEVEL=7
